#. module: hisabkar_privacy
#: model:ir.model,name:hisabkar_privacy.model_hisabkar_privacy
msgid "Hisabkar privacy hardening"
msgstr "حسابکار رازداری تحفظ"

#. module: hisabkar_privacy
#: code:addons/hisabkar_privacy/models/ir_module.py:0
msgid ""
"Removing the blocked modules would also remove %(modules)s. Resolve this by "
"hand before installing Hisabkar Privacy."
msgstr ""
"ممنوعہ ماڈیولز ہٹانے سے یہ بھی ہٹ جائیں گے: %(modules)s۔ حسابکار پرائیویسی "
"انسٹال کرنے سے پہلے یہ معاملہ خود حل کریں۔"

#. module: hisabkar_privacy
#: code:addons/hisabkar_privacy/models/ir_module.py:0
msgid ""
"These modules send data to outside services and are blocked by Hisabkar's "
"privacy policy: %(modules)s"
msgstr ""
"یہ ماڈیولز ڈیٹا بیرونی سروسز کو بھیجتے ہیں اور حسابکار کی رازداری پالیسی کے تحت "
"ممنوع ہیں: %(modules)s"
